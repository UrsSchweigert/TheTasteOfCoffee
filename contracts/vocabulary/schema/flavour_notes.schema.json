{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flavour_notes.schema.json",
  "title": "Flavour notes: two levels, category then note",
  "type": "object",
  "required": ["version", "status", "max_picks", "flavour_categories"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "max_picks": { "type": "integer", "minimum": 1, "maximum": 20 },
    "flavour_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "flavour_notes"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "flavour_notes": { "$ref": "common.schema.json#/$defs/id_list" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
