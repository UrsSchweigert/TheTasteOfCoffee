{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shelf.schema.json",
  "title": "Shelf vocabulary: bag sizes and price bands",
  "type": "object",
  "required": ["version", "status", "bag_sizes", "price_band_basis", "price_bands"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "bag_sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "grams"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "grams": { "type": "integer", "minimum": 1, "maximum": 100000 }
        },
        "additionalProperties": false
      }
    },
    "price_band_basis": {
      "type": "object",
      "required": ["currency", "per_grams"],
      "properties": {
        "currency": { "enum": ["EUR"] },
        "per_grams": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "additionalProperties": false
    },
    "price_bands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "minimum"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "minimum": { "type": "number", "minimum": 0 },
          "maximum_exclusive": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
