{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "histogram_buckets.schema.json",
  "title": "Histogram bucket definitions for the recipe parameters the community aggregates keep (ADR 0035)",
  "type": "object",
  "required": ["version", "vocabulary_version", "parameters"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "vocabulary_version": { "type": "integer", "minimum": 3, "maximum": 1000 },
    "parameters": {
      "type": "object",
      "required": ["ratio", "grind_normalised", "water_temp_c", "brew_time_s"],
      "properties": {
        "ratio": { "$ref": "#/$defs/parameter" },
        "grind_normalised": { "$ref": "#/$defs/parameter" },
        "water_temp_c": { "$ref": "#/$defs/parameter" },
        "brew_time_s": { "$ref": "#/$defs/parameter" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 60 },
    "parameter": {
      "type": "object",
      "required": ["source_fields", "scale", "sets"],
      "properties": {
        "source_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "enum": ["water_g", "dose_dg", "grind_normalised", "water_temp_c", "brew_time_s"] }
        },
        "scale": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "sets": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/set" } }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "required": ["id", "methods", "buckets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "methods": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "buckets": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "$ref": "#/$defs/bucket" } }
      },
      "additionalProperties": false
    },
    "bucket": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "to": { "type": "integer", "minimum": 1, "maximum": 100000000 }
      },
      "additionalProperties": false
    }
  }
}
