{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasons.schema.json",
  "title": "Plausibility reason ids: why the nightly rebuild leaves a brew out of the community numbers (ADR 0035)",
  "type": "object",
  "required": ["version", "reasons"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 40 } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
