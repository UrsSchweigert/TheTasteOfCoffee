    "sync_issues.bean_change_reverted.message" : {
      "comment" : "Sync issue: a bag's bean change was refused because brews reference the bag.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Packung sind Zubereitungen erfasst, deshalb kann sich die Bohne nicht ändern. Die vorige Bohne ist zurück, die übrigen Änderungen wurden gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brews are logged for this bag, so its bean cannot change. The previous bean is back, and the other changes were saved."
          }
        }
      }
    },
