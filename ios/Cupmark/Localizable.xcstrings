    "onboarding.private.message" : {
      "comment" : "Text of the second onboarding page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tagebuch wird zuerst auf diesem iPhone gespeichert, funktioniert also ohne Verbindung und wird mit deinem Konto abgeglichen, sobald du online bist. Cupmark kennt dich nur über „Mit Apple anmelden“, ohne deinen Namen und ohne deine E-Mail-Adresse. Andere sehen dein Tagebuch nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your log is saved on this iPhone first, so it works without a connection, and it syncs to your account when you are online. Cupmark knows you only through Sign in with Apple, without your name or email address. Other people never see your log."
          }
        }
      }
