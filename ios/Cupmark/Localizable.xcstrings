      "comment" : "Shown when the bundled vocabulary cannot be loaded.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kaffeebegriffe der App konnten nicht geladen werden. Bitte installiere die App neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app could not load its coffee terms. Please reinstall the app."
          }
        }
      }
    },
