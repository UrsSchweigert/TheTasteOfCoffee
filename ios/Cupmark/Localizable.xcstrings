    "not_configured.message" : {
      "comment" : "Shown when the build has no valid server configuration, so the app cannot connect.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version der App hat keine gültigen Servereinstellungen und kann sich deshalb nicht verbinden. Bitte installiere eine aktuelle Version."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version of the app has no valid server settings, so it cannot connect. Please install an up-to-date version."
          }
        }
      }
    },
    "not_configured.title" : {
      "comment" : "Title of the screen shown when the build has no valid server configuration.",
