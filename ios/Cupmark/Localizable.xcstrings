    "account_deletion.what.photos" : {
      "comment" : "Second item of what account deletion deletes: label photos of beans that are not verified.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Etikettenfotos, die du von nicht bestätigten Bohnen gemacht hast. Fotos bestätigter Bohnen bleiben im Katalog, ohne Verbindung zu dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The label photos you took of beans that are not verified. Photos of verified beans stay in the catalogue without any link to you."
          }
        }
      }
    },
    "account_deletion.what.sign_in" : {
      "comment" : "Third item of what account deletion deletes: the sign-in.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldung: Dein Cupmark-Konto wird entfernt, und dieses iPhone wird abgemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in: your Cupmark account is removed, and this iPhone is signed out."
          }
        }
