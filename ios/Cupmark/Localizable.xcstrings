        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point the camera at the barcode on the bag."
          }
        }
      }
    },
    "scanner.not_available.message" : {
      "comment" : "Explains that the camera cannot scan right now, and what to do instead.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera kann gerade nicht scannen. Versuche es später noch einmal, prüfe die Einstellungen oder beschreibe die Bohne mit Auswahllisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera cannot scan right now. Try again later, check Settings, or describe the bean with pick lists."
          }
        }
      }
    },
    "scanner.not_available.title" : {
      "comment" : "Title when the camera cannot scan right now.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen nicht verfügbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanning not available"
          }
        }
      }
    },
