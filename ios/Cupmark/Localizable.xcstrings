{
  "sourceLanguage" : "en",
  "strings" : {
    "account.sign_out" : {
      "comment" : "Button and confirmation action that sign the user out.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abmelden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign Out"
          }
        }
      }
    },
    "account.sign_out.confirm_title" : {
      "comment" : "Title of the confirmation before signing out.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Cupmark abmelden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign out of Cupmark?"
          }
        }
      }
    },
    "account_deletion.cleanup_failed" : {
      "comment" : "Shown when the account was deleted on the server but local data could not all be removed yet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wurde auf dem Server gelöscht, aber einige Daten auf diesem iPhone konnten noch nicht entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account was deleted on the server, but some data on this iPhone could not be removed yet."
          }
        }
      }
    },
    "account_deletion.confirm" : {
      "comment" : "Destructive button of the final confirmation that starts account deletion.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete Account"
          }
        }
      }
    },
    "account_deletion.confirm.message" : {
      "comment" : "Message of the final confirmation of account deletion: what is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten, die Etikettenfotos nicht bestätigter Bohnen und deine Anmeldung werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data, the label photos of unverified beans and your sign-in are deleted. This cannot be undone."
          }
        }
      }
    },
    "account_deletion.confirm.title" : {
      "comment" : "Title of the final confirmation of account deletion.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto endgültig löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete Your Account for Good?"
          }
        }
      }
    },
    "account_deletion.continue" : {
      "comment" : "First confirmation step of account deletion: opens the final confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiter zum Löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue to Deletion"
          }
        }
      }
    },
    "account_deletion.continue.hint" : {
      "comment" : "VoiceOver hint of the first confirmation step of account deletion.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt noch einmal, bevor etwas gelöscht wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks once more before anything is deleted."
          }
        }
      }
    },
    "account_deletion.could_not_start" : {
      "comment" : "Shown when account deletion could not record its start; nothing was deleted or sent.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen konnte nicht gestartet werden. Es wurde nichts gelöscht. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The deletion could not be started. Nothing was deleted. Please try again."
          }
        }
      }
    },
    "account_deletion.delete_this_account" : {
      "comment" : "Destructive button that deletes the account the user is signed in with now, after a different or unknown account was found.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete This Account"
          }
        }
      }
    },
    "account_deletion.delete_this_account.hint" : {
      "comment" : "VoiceOver hint of the Delete This Account button.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht das Konto, mit dem du gerade angemeldet bist, und alle seine Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the account you are signed in with now and all its data."
          }
        }
      }
    },
    "account_deletion.different_account.message" : {
      "comment" : "Shown during an account deletion after the user signed in with a different account than the one being deleted. Nothing is deleted until a button is tapped.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich mit einem anderen Konto angemeldet als dem, das du löschen wolltest. Das Konto, das du löschen wolltest, ist vielleicht schon gelöscht, vielleicht gibt es es aber noch. Wenn du fortfährst, werden **dieses** Konto und alle seine Daten gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You signed in with a different account than the one you asked to delete. The account you asked to delete may already be gone, or it may still exist. If you continue, **this** account and all its data are deleted, and this cannot be undone."
          }
        }
      }
    },
    "account_deletion.export_hint" : {
      "comment" : "Footer below the first confirmation step of account deletion.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Kopie behalten möchtest, exportiere deine Daten zuerst in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To keep a copy, export your data in Settings first."
          }
        }
      }
    },
    "account_deletion.progress.message" : {
      "comment" : "Shown while the account is being deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bleibst angemeldet, bis der Server das Löschen bestätigt. Wenn Cupmark geschlossen wird, geht das Löschen beim nächsten Öffnen weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay signed in until the server confirms the deletion. If Cupmark closes, the deletion goes on the next time you open it."
          }
        }
      }
    },
    "account_deletion.progress.title" : {
      "comment" : "Title of the screen shown while the account is being deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wird gelöscht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting Your Account"
          }
        }
      }
    },
    "account_deletion.retry_now" : {
      "comment" : "Button that tries the account deletion again at once.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt versuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try Now"
          }
        }
      }
    },
    "account_deletion.retrying" : {
      "comment" : "Shown while account deletion waits to try the server again.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server war nicht erreichbar oder konnte noch nicht fertig werden. Cupmark versucht es von selbst erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server could not be reached or could not finish yet. Cupmark tries again by itself."
          }
        }
      }
    },
    "account_deletion.settings_footer" : {
      "comment" : "Footer below the Delete Account row in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine Daten, die Etikettenfotos nicht bestätigter Bohnen und deine Anmeldung, auf dem Server und auf diesem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes your data, the label photos of unverified beans and your sign-in, on the server and on this iPhone."
          }
        }
      }
    },
    "account_deletion.sign_in_again" : {
      "comment" : "Button that signs in again to finish deleting the account.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut anmelden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign In Again"
          }
        }
      }
    },
    "account_deletion.sign_in_note" : {
      "comment" : "Shown on the sign-in screen and the deletion progress screen while an account deletion waits for a new sign-in: which account a sign-in deletes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit dem Konto an, das du löschen wolltest, um das Löschen abzuschließen. Wenn du dich mit einem anderen Konto anmeldest, fragt Cupmark dich, bevor etwas gelöscht wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with the account you asked to delete to finish deleting it. If you sign in with a different account, Cupmark asks you before it deletes anything."
          }
        }
      }
    },
    "account_deletion.sign_in_required" : {
      "comment" : "Shown while account deletion needs a new sign-in because the sign-in could not be renewed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldung konnte nicht erneuert werden. Melde dich erneut an, um das Löschen abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in could not be renewed. Sign in again to finish deleting your account."
          }
        }
      }
    },
    "account_deletion.sign_out_instead" : {
      "comment" : "Button that signs out of the account signed in now instead of deleting it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abmelden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign Out"
          }
        }
      }
    },
    "account_deletion.sign_out_instead.hint" : {
      "comment" : "VoiceOver hint of the Sign Out button shown instead of deleting a different account.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich von diesem Konto ab. Es wird nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signs out of this account. Nothing is deleted."
          }
        }
      }
    },
    "account_deletion.title" : {
      "comment" : "Settings row and screen title that lead to deleting the account.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete Account"
          }
        }
      }
    },
    "account_deletion.unreadable_record.message" : {
      "comment" : "Shown when the record of an account deletion on this device cannot be read. Nothing is deleted until a button is tapped.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iPhone wurde das Löschen eines Kontos begonnen, aber sein Eintrag kann nicht gelesen werden. Wenn du fortfährst, werden **das Konto, mit dem du angemeldet bist,** und alle seine Daten gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An account deletion was started on this iPhone, but its record cannot be read. If you continue, **the account you are signed in with** and all its data are deleted, and this cannot be undone."
          }
        }
      }
    },
    "account_deletion.what.data" : {
      "comment" : "First item of what account deletion deletes: the user's data.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten: Regal, Zubereitungen, Bewertungen, Rezepte, Statistik und Einstellungen, auf dem Server und auf diesem iPhone, auch noch nicht gesendete Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data: shelf, brews, ratings, recipes, statistics and settings, on the server and on this iPhone, including changes not sent yet."
          }
        }
      }
    },
    "account_deletion.what.footer" : {
      "comment" : "Footer below the list of what account deletion deletes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be undone."
          }
        }
      }
    },
    "account_deletion.what.header" : {
      "comment" : "Header of the list of what account deletion deletes.",
