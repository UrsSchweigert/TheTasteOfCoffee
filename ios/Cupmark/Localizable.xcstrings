      "comment" : "Instruction shown over the camera while scanning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera auf den Barcode der Packung."
