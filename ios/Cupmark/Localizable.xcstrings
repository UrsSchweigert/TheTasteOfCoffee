        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account you signed in with and chose to delete, and its data, were deleted."
          }
        }
      }
    },
    "sign_in.required_by_server" : {
      "comment" : "Shown on the sign-in screen after the server refused the session, also after a refresh: the account was deleted (for example on another device) or its sign-in ended.",
