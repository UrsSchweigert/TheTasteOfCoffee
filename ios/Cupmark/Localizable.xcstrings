    "lookup.confirm.message" : {
      "comment" : "Explains the Open Food Facts confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Food Facts kennt diesen Barcode. Bestätige, wenn er zu deiner Packung passt, dann kommt er als ungeprüfte Bohne in den Cupmark-Katalog."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Food Facts knows this barcode. Confirm if it matches your bag, and it is added to the Cupmark catalogue as an unverified bean."
          }
        }
      }
    },
    "lookup.confirm.title" : {
      "comment" : "Header of the Open Food Facts confirmation.",
