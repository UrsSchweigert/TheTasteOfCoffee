    "onboarding.log.message" : {
      "comment" : "Text of the first onboarding page: what the app does.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne eine Packung oder wähle ihre Angaben aus Listen, stelle sie in dein Regal und erfasse jede Zubereitung mit einer Bewertung. Du wählst alles aus, eintippen musst du nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan a bag or pick its details from lists, keep it on your shelf, and log each brew with a rating. You pick and tap everything; there is nothing to type."
          }
        }
      }
    },
    "onboarding.log.title" : {
