    "local_data.confirm.message" : {
      "comment" : "Message of the confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das löscht alles, was auf diesem Gerät für andere Konten als das angemeldete gespeichert ist, auch Änderungen, die nie gesendet wurden. Auf dem Server wird nichts gelöscht, und deine eigenen Daten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes everything stored on this device for accounts other than the one signed in, including changes that were never sent. Nothing on the server is deleted, and your own data stays."
          }
        }
      }
    },
    "local_data.confirm.title" : {
      "comment" : "Title of the confirmation.",
      "extractionState" : "manual",
