      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Verbindung. Prüfe deine Internetverbindung und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No connection. Check your internet connection and try again."
          }
        }
      }
