    "scanner.permission_denied.message" : {
      "comment" : "Explains how to allow camera access, and what to do instead.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Cupmark in den Einstellungen den Kamerazugriff, um Barcodes zu scannen, oder beschreibe die Bohne mit Auswahllisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow camera access for Cupmark in Settings to scan barcodes, or describe the bean with pick lists."
