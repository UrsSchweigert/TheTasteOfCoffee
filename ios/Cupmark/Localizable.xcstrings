    "onboarding.consent.change_later" : {
      "comment" : "Note below the agree switch on the consent page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus, solange du es nicht einschaltest. Du kannst es jederzeit in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off unless you turn it on. You can change it at any time in Settings."
          }
        }
      }
    },
    "onboarding.consent.message" : {
      "comment" : "Consent page: what is shared if the user agrees. Must stay plain and exact: ratings with method and recipe values, no identity, shown only from 5 raters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cupmark kann für jeden Kaffee Werte der Community zeigen, etwa durchschnittliche Bewertungen und die häufigsten Aromen. Diese Werte sehen Abonnentinnen und Abonnenten sowie Personen, die denselben Kaffee bewertet haben. Wenn du zustimmst, fließen deine Bewertungen in diese Werte ein, solange das Teilen an ist, zusammen mit der Zubereitungsart und den Rezeptwerten, aber nie mit deinem Namen oder deinem Konto. Die Werte eines Kaffees werden erst gezeigt, wenn ihn mindestens 5 verschiedene Personen bewertet haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cupmark can show community figures for each coffee, such as average scores and the most common flavour notes. Subscribers, and people who rated the same coffee, see these figures. If you agree, your ratings are counted into them while sharing is on, together with the brew method and recipe values, but never with your name or account. A coffee's figures are shown only once at least 5 different people have rated it."
          }
        }
      }
    },
    "onboarding.consent.not_shared" : {
      "comment" : "Consent page: what is not shared, and that declining changes nothing in the personal log.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst wird nichts geteilt: weder dein Regal noch deine Rezepte, deine Statistik oder etwas über dich. Wenn du nicht zustimmst, wird nichts von dir gezählt, und dein eigenes Tagebuch funktioniert genauso."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing else is shared: not your shelf, your recipes, your statistics or anything about you. If you do not agree, nothing of yours is counted, and your own log works exactly the same."
          }
        }
      }
    },
    "onboarding.consent.title" : {
      "comment" : "Title of the consent page of onboarding (opt-in to community aggregates).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewertungen anonym teilen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share Your Ratings Anonymously?"
          }
        }
      }
    },
