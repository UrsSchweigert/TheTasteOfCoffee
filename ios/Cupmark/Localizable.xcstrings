    "sign_in.message" : {
      "comment" : "Explains on the sign-in screen why to sign in and what the app does not ask for.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um deine Bohnen, Zubereitungen und Bewertungen zu speichern. Cupmark fragt weder nach deinem Namen noch nach deiner E-Mail-Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to keep your beans, brews and ratings. Cupmark does not ask for your name or your email address."
          }
        }
      }
    },
    "sign_in.offline" : {
      "comment" : "Shown on the sign-in screen when there is no network connection.",
