{
  "name": "cupmark-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Cupmark Lambda handlers (TypeScript, Node 22, arm64)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": "^22.18.0 || >=24" },
  "scripts": {
    "generate": "node scripts/generate-contract.ts",
    "check:generated": "node scripts/generate-contract.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dynamodb:start": "docker run --rm -d --name cupmark-dynamodb-local -p 127.0.0.1:8000:8000 amazon/dynamodb-local:3.3.2@sha256:6ada631ec7aa5fc83446855eb17233e3dad184fec47477e8140c6c569cfe0c86 -jar DynamoDBLocal.jar -inMemory",
    "dynamodb:stop": "docker stop cupmark-dynamodb-local",
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1177.0",
    "@aws-sdk/client-ssm": "3.1177.0",
    "@aws-sdk/lib-dynamodb": "3.1177.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
