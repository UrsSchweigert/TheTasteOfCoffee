{
  "name": "cupmark-infra",
  "version": "0.0.0",
  "private": true,
  "description": "Cupmark AWS CDK app (TypeScript, eu-central-1, dev and prod stages)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": "^22.18.0 || >=24" },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --no-lookups --quiet",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.278.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1149.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
